/* TEST ASSET - NOT THE REAL HUD STYLING.
   Plain boxes so it is obvious at a glance which element reacted to which channel.
   Every element is position: absolute so toggling one's display never reflows the others —
   the real HUD must do the same, or one presenter's Raise visibly shoves another's text. */

.test-hud {
    flex-grow: 1;
    position: relative;
    padding: 16px;
}

.test-hud__banner {
    position: absolute;
    top: 16px;
    left: 16px;
    color: rgb(255, 220, 120);
    -unity-font-style: bold;
    font-size: 14px;
}

.test-hud__toast {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgba(20, 30, 25, 0.85);
    border-left-width: 3px;
    border-left-color: rgb(120, 220, 150);
    padding: 8px 12px;
}

.test-hud__toast-title {
    color: rgb(200, 245, 215);
    -unity-font-style: bold;
}

.test-hud__toast-line {
    color: rgb(160, 200, 175);
    font-size: 12px;
}

.test-hud__prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    color: rgb(235, 235, 235);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 4px 10px;
}

.test-hud__subtitle {
    position: absolute;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    color: rgb(225, 235, 230);
    background-color: rgba(0, 0, 0, 0.6);
    padding: 6px 14px;
    white-space: normal;
    max-width: 70%;
}
