<?xml version="1.0" encoding="utf-8"?>
<!--
  TEST ASSET - NOT THE REAL HUD.
  Throwaway layout used only to prove the "build UI without a level" workflow: select a channel
  .asset under Data/Events/ and use its Inspector's Raise button. It is deliberately ugly: it
  exists to show that the element names below are the whole contract between gameplay and UI.
  The real HUD lives in Assets/RootsDance/UI/ and belongs to the UI owner.

  Every element is position: absolute in Test_HUD.uss on purpose: a real HUD's overlay pieces
  must not share flex flow, or one presenter's Raise shifts another's already-visible text.

  Element names the presenters look up - renaming any of these breaks them:
    prompt__label        InteractionPromptPresenter
    subtitle__text       SubtitlePresenter
    report-toast         ReportToastPresenter (container)
    report-toast__title  ReportToastPresenter
    report-toast__line   ReportToastPresenter
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Test_HUD.uss" />
    <ui:VisualElement name="test-hud" class="test-hud">
        <ui:Label name="test-hud__banner" class="test-hud__banner" text="TEST HUD — sandbox only, not the real UI" />

        <ui:VisualElement name="report-toast" class="test-hud__toast">
            <ui:Label name="report-toast__title" class="test-hud__toast-title" />
            <ui:Label name="report-toast__line" class="test-hud__toast-line" />
        </ui:VisualElement>

        <ui:Label name="prompt__label" class="test-hud__prompt" />

        <ui:Label name="subtitle__text" class="test-hud__subtitle" />
    </ui:VisualElement>
</ui:UXML>
