/* PLACEHOLDER STYLING - functionality only, UI owner replaces this. */

.main-menu {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 24, 22);
}

.main-menu__title {
    color: rgb(225, 235, 230);
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 24px;
}

.main-menu__start-button {
    font-size: 18px;
    padding: 10px 28px;
}
