  m_Name: DLG-002_WhoIsShe
  m_EditorClassIdentifier: RootsDance.Runtime::RootsDance.Dialogue.DialogueSO
  m_id: DLG-002
  m_title: "\u8FFD\u95EE\u300C\u5979\u300D"
  m_choices: []
  m_choicesRepeat: 1
  m_requiredFlag: 
  m_playsOnce: 1
  m_lines:
  - m_speaker: 0
    m_chinese: "\u5979\u662F\u8C01\uFF1F"
    m_english: Who is she?
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 63c0b9ce6005e4750ab451250a33da66, type: 3}
  - m_speaker: 1
    m_chinese: "\u5C31\u662F\u2026\u2026\u5C31\u662F\u5979\u5566\u3002"
    m_english: Her. I mean... her.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: b7efc793af0814c12ba174fc38255e13, type: 3}
  - m_speaker: 1
    m_chinese: "\u8FD9\u91CC\u662F\u5979\u7684\u54E6\u3002"
    m_english: This is hers.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: aee42377ab2d8426e873d54160905655, type: 3}
  - m_speaker: 1
    m_chinese: "\u55EF\uFF0C\u4E4B\u524D\u662F\u3002"
    m_english: Well. It was.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 3ad47bed9e96a42858fe1630d9744d06, type: 3}
  m_flagOnComplete: flow.heard_about_her
