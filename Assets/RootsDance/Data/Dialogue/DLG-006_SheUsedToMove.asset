  m_Name: DLG-006_SheUsedToMove
  m_EditorClassIdentifier: RootsDance.Runtime::RootsDance.Dialogue.DialogueSO
  m_id: DLG-006
  m_title: "\u76D6\u5A05\u96D5\u50CF"
  m_choices: []
  m_choicesRepeat: 1
  m_requiredFlag: 
  m_playsOnce: 1
  m_lines:
  - m_speaker: 1
    m_chinese: "\u5979\u4EE5\u524D\u4F1A\u6D41\u52A8\u3002"
    m_english: She used to move.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: c00865188907c47ed94afc20b1861af8, type: 3}
  - m_speaker: 1
    m_chinese: "\u5F88\u6F02\u4EAE\u3002"
    m_english: She was beautiful.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 934057ebf794348598f7e04876595ad6, type: 3}
  - m_speaker: 1
    m_chinese: "\u7136\u540E\u6709\u4E00\u5929\uFF0C\u5979\u5C31\u505C\u4E0B\u6765\u4E86\u3002"
    m_english: Then one day, she stopped.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 772d71c942541434596acfb82ac767eb, type: 3}
  - m_speaker: 0
    m_chinese: "\u5979\uFF1F"
    m_english: She?
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: eb7d99db2ab4245949c28c0a3f4e8c93, type: 3}
  - m_speaker: 1
    m_chinese: "\u55EF\u3002\u5979\u3002"
    m_english: Yeah. Her.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: b53c130ee79e24b04881fc6ff15998aa, type: 3}
  m_flagOnComplete: 
