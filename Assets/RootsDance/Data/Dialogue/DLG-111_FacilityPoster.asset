  m_lines:
  - m_speaker: 0
    m_chinese: "\u7814\u7A76\u6240\u7684\u65E7\u5BA3\u4F20\u6D77\u62A5\u3002\u90A3\u65F6\u5019\u4ED6\u4EEC\u8FD8\u6B22\u8FCE\u53C2\u89C2\u3002"
    m_english: "An old promotional poster. Back when they still welcomed visitors."
    m_voice: {fileID: 0}
    m_holdSeconds: 0
  - m_speaker: 0
    m_chinese: "\u89D2\u843D\u91CC\u4E00\u884C\u5C0F\u5B57\uFF1A\u8BBE\u5907\u7EF4\u62A4\u533A\u2014\u2014\u5730\u4E0B\u3002"
    m_english: "Small print in the corner: equipment maintenance - below ground."
    m_voice: {fileID: 0}
    m_holdSeconds: 0
