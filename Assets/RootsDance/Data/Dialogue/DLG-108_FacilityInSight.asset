  m_lines:
  - m_speaker: 0
    m_chinese: "\u524D\u9762\u90A3\u4E2A\uFF0C\u4E0D\u5728\u6211\u7684\u5730\u56FE\u4E0A\u3002"
    m_english: "That, up ahead - it isn't on my map."
    m_voice: {fileID: 0}
    m_holdSeconds: 0
  - m_speaker: 0
    m_chinese: "\u8FD9\u4E48\u5927\u4E00\u5EA7\u8BBE\u65BD\uFF0C\u62A5\u544A\u91CC\u4E00\u4E2A\u5B57\u90FD\u6CA1\u63D0\u3002"
    m_english: "A facility that size, and the reports never spent a word on it."
    m_voice: {fileID: 0}
