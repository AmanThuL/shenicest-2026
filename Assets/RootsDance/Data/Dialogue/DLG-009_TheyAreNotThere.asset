%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bedbc64d8f3194ffe840270848be2d68, type: 3}
  m_Name: DLG-009_TheyAreNotThere
  m_EditorClassIdentifier: RootsDance.Runtime::RootsDance.Dialogue.DialogueSO
  m_id: DLG-009
  m_title: "\u9519\u8BEF\u5FAA\u73AF\uFF1A\u5B83\u4EEC\u5DF2\u7ECF\u4E0D\u5728\u90A3\u91CC\u4E86"
  m_choices: []
  m_choicesRepeat: 1
  m_requiredFlag: 
  m_playsOnce: 1
  m_lines:
  - m_speaker: 1
    m_chinese: "\u54E6\u3002\u54E6\u54E6\u54E6\u3002"
    m_english: Oh. Oh, oh, oh.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: ad6f86ed5f6b9467a95c0bd84de5cd91, type: 3}
  - m_speaker: 1
    m_chinese: "\u4F60\u9009\u4E86\u8FD9\u4E2A\u3002"
    m_english: You picked this.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: e288b98e0b78342e3ae8d3ad38852962, type: 3}
  - m_speaker: 1
    m_chinese: "\u6CA1\u5173\u7CFB\uFF0C\u6CA1\u5173\u7CFB\uFF0C\u673A\u5668\u6709\u65F6\u5019\u5C31\u662F\u4F1A\u2014\u2014"
    m_english: "It's okay. It's okay. Machines just sometimes\u2014"
    m_holdSeconds: 0
    m_voice: {fileID: 0}
  - m_speaker: 1
    m_chinese: "\u2026\u2026\u7B49\u7B49\u3002"
    m_english: ...Wait.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: e680618963fab464c81a5c086532c4dc, type: 3}
  - m_speaker: 1
    m_chinese: "\u4F60\u771F\u7684\u9009\u4E86\u8FD9\u4E2A\u3002"
    m_english: You really picked this.
    m_holdSeconds: 0
    m_voice: {fileID: 0}
  - m_speaker: 1
    m_chinese: "\u4E0D\uFF0C\u4E0D\uFF0C\u4E0D\u4E0D\u4E0D\u3002"
    m_english: No. No, no, no.
    m_holdSeconds: 0
    m_voice: {fileID: 0}
  - m_speaker: 1
    m_chinese: "\u505C\u4E0B\u6765\u3002"
    m_english: Stop it.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: e4740a41e7c604e32848d15b33c730d3, type: 3}
  - m_speaker: 1
    m_chinese: "\u628A\u5B83\u505C\u4E0B\u6765\u3002"
    m_english: Make it stop.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 1b286f930a2c84739bce328b10ed9548, type: 3}
  - m_speaker: 1
    m_chinese: "\u5B83\u4EEC\u5DF2\u7ECF\u4E0D\u5728\u90A3\u91CC\u4E86\uFF01"
    m_english: They're not there anymore!
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 8b5da8bba8a8a41ca85557b75c4fcb8b, type: 3}
  - m_speaker: 1
    m_chinese: "\u62FF\u7740\u4E1C\u897F\u3002\u7AD9\u5728\u8FD9\u91CC\u3002"
    m_english: Take things. Stand here.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 8d40bd6d63ec0456881c50233806b633, type: 3}
  - m_speaker: 1
    m_chinese: "\u7136\u540E\u8BF4\uFF0C\u55EF\uFF0C\u8FD9\u91CC\u5E94\u8BE5\u8FD9\u6837\u3002"
    m_english: And then say, um, it should be like this.
    m_holdSeconds: 0
    m_voice: {fileID: 0}
  - m_speaker: 1
    m_chinese: "\u53EF\u662F\u2014\u2014"
    m_english: "But\u2014"
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: b24ce554189f34143a901ff823d30a36, type: 3}
  - m_speaker: 1
    m_chinese: "\u505C\u4E0B\u6765\u3002"
    m_english: Stop.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 51c7dcde6fbb74191860a4a5caa7e200, type: 3}
  - m_speaker: 1
    m_chinese: "\u505C\u4E0B\u6765\uFF01"
    m_english: Stop!
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: c7905927e9f704a60a4d6a31aecf0486, type: 3}
  - m_speaker: 1
    m_chinese: "\u5B83\u4EEC\u5DF2\u7ECF\u4E0D\u5728\u90A3\u91CC\u4E86\uFF01"
    m_english: They're not there anymore!
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: dffcc7820e51e4714afb7656ea32823e, type: 3}
  - m_speaker: 1
    m_chinese: "\u4E3A\u4EC0\u4E48\u4F60\u4EEC\u603B\u60F3\u8BA9\u6D3B\u7740\u7684\u4E1C\u897F\uFF0C\u56DE\u5230\u5DF2\u7ECF\u6B7B\u6389\u7684\u5730\u65B9\uFF1F"
    m_english: Why do you always want to make living things go back to somewhere
      that's already dead?
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: 8360700b675894a6abe78f244501f089, type: 3}
  - m_speaker: 1
    m_chinese: "\u5B83\u4EEC\u6CA1\u6709\u51FA\u9519\u3002"
    m_english: They didn't do anything wrong.
    m_holdSeconds: 0
    m_voice: {fileID: 8300000, guid: bcf4619e0e087473da344c2f240cd530, type: 3}
  m_flagOnComplete: flow.wrong_cycle_outburst_done
