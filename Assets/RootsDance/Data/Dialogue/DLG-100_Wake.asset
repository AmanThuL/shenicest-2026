  m_title: "\u9ED1\u5C4F\u82CF\u9192\uFF0800-01\uFF09"
  m_choices: []
  m_choicesRepeat: 1
  m_requiredFlag: 
  m_playsOnce: 1
  m_lines:
  - m_speaker: 0
    m_chinese: "\u2026\u2026\u5230\u4E86\u3002\u65E7\u89C2\u6D4B\u7AD9\u5916\u56F4\u3002"
    m_english: "...Here. The old observation station's perimeter."
    m_voice: {fileID: 0}
    m_holdSeconds: 0
  - m_speaker: 0
    m_chinese: "\u6863\u6848\u8BF4\u8FD9\u91CC\u4E09\u5341\u5E74\u6CA1\u4EBA\u6765\u8FC7\u3002\u770B\u8D77\u6765\u50CF\u4E09\u767E\u5E74\u3002"
    m_english: "The files say nobody's been here in thirty years. It looks more like three hundred."
    m_voice: {fileID: 0}
    m_holdSeconds: 0
