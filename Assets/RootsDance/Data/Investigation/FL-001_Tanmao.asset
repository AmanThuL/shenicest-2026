  m_resultBody: "\u8BC6\u522B\u5BF9\u8C61\u7F16\u53F7\uFF1AFL-001\n\u7C7B\u522B\uFF1A\u8349\u672C\u690D\u7269\n\u6570\u636E\u5E93\u5339\u914D\uFF1A\u5DF2\u786E\u8BA4\n\u7269\u79CD\uFF1A\u6BEF\u8305\n\u751F\u957F\u72B6\u6001\uFF1A\u7A33\u5B9A\n\u533A\u57DF\uFF1A\u9057\u8FF9\u6700\u5916\u90E8\u4F4E\u6C61\u67D3\u533A\n\u5EFA\u8BAE\uFF1A\u65E0\u9700\u91C7\u6837"
