  m_promptText: "[E] \u91C7\u6837 \u6B8B\u7559\u79EF\u6C34"
  m_resultBody: "\u9759\u6B62\u4E8E\u6C34\u69FD\u5E95\u90E8\u7684\u96E8\u6C34\uFF0C\u65E0\u6D41\u52A8\uFF0C\u8868\u5C42\u6D6E\u6709\u67AF\u53F6\u4E0E\u7EC6\u788E\u6709\u673A\u6B8B\u6E23\u3002\u6C34\u8272\u504F\u9EC4\u7EFF\uFF0C\u6D51\u6D4A\u5EA6\u9AD8\u3002\u672A\u68C0\u51FA\u5FAA\u73AF\u7CFB\u7EDF\u6295\u52A0\u7684\u8C03\u8282\u5242\u6B8B\u7559\u2014\u2014\u8FD9\u4E00\u6C60\u6C34\u662F\u5C4B\u9876\u6F0F\u4E0B\u6765\u7684\uFF0C\u4E0D\u662F\u8BBE\u65BD\u4F9B\u7ED9\u7684\u3002"
  m_monologueLines:
  - "\u4F9B\u6C34\u505C\u4E86\u5F88\u4E45\u4E86\u3002\u8FD9\u6C34\u662F\u5929\u4E0A\u4E0B\u7684\u3002"
