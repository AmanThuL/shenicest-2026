    AmplifyShaderEditor\",\"id\":1288,\"pos\":[-5248,-640],\"params\":[\"Inherit\",\"False\",\"Constant\",\"_OverlayGlitterRadiusValue\",\"\",\"61\",\"0\",\"Create\",\"False\",\"0\",\"0\",\"0\",\"False\",\"0\",\"False\",\"Object\",\"-1\",\"\",\"3\",\"0.8\",\"0\",\"0\",\"0\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.CustomExpressionNode,
    AmplifyShaderEditor\",\"id\":1273,\"pos\":[-4736,-896],\"params\":[\"Inherit\",\"False\",\"   
    float3 uv = PositionWS * Amount;\\n    float3 cell = floor(uv);\\n\\n    // Inline
    Hash31\\n    float3 p = frac(cell * 0.1031);\\n    p += dot(p, p.yzx + 33.33);\\n   
    float h = frac((p.x + p.y) * p.z);\\n\\n    // Random position inside the voxel\\n   
    float3 rnd = frac(h * float3(13.371, 91.173, 47.853));\\n\\n    float3 delta
    = frac(uv) - rnd;\\n    float d2 = dot(delta, delta);\\n\\n    // Derivative-based
    AA\\n    //float3 fw = fwidth(uv);\\n    //float radius2 = max(0.0064, dot(fw,
    fw) * 0.5625);\\n\\n    // Camera-driven twinkle\\n    float density = smoothstep(0.97,
    1.0, frac(h + CameraRnd));\\n\\n    // Diamond distance (L1 norm)\\n    float
    d = abs(delta.x) + abs(delta.y) + abs(delta.z);\\n\\n    float radiusRnd = frac(h
    * 91.173);\\n    radiusRnd = radiusRnd * radiusRnd * radiusRnd;\\n    float radius
    = Radius * lerp(0.3, 1.0, radiusRnd);\\n\\n    float sparkle = density * (1.0
    - smoothstep(0.0, radius, d));\\n\\n    // Sparkle\\n    //float sparkle =  density
    * (1.0 - smoothstep(0.0, radius2, d2));\\n\\n    return sparkle;\",\"1\",\"Create\",\"4\",\"True\",\"PositionWS\",\"FLOAT3\",\"0,0,0\",\"In\",\"\",\"Float\",\"False\",\"True\",\"CameraRnd\",\"FLOAT\",\"0\",\"In\",\"\",\"Inherit\",\"False\",\"True\",\"Amount\",\"FLOAT\",\"0\",\"In\",\"\",\"Inherit\",\"False\",\"True\",\"Radius\",\"FLOAT\",\"0\",\"In\",\"\",\"Inherit\",\"False\",\"ComputeGlitter3D\",\"True\",\"False\",\"0\",\"\",\"False\",\"4\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT\",\"0\",\"False\",\"2\",\"FLOAT\",\"0\",\"False\",\"3\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.RangedFloatNode,
