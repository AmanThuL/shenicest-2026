    // 2 * sqrt (3)\\n\\n// Skew input space into simplex triangle grid\\nconst float2x2
    gridToSkewedGrid = float2x2( 1.0, 0.0, -0.57735027, 1.15470054 );\\nhalf2 skewedCoord
    = mul( gridToSkewedGrid, uv );\\n\\n// Compute local triangle vertex IDs and
    local barycentric coordinates\\nint2 baseId = int2( floor( skewedCoord ) );\\nhalf3
    temp = half3( frac( skewedCoord ), 0 );\\ntemp.z = 1.0 - temp.x - temp.y;\\nif
    ( temp.z > 0.0 )\\n{\\n\\tWeights.x = temp.z;\\n\\tWeights.y = temp.y;\\n\\tWeights.z
    = temp.x;\\n\\tvertex1 = baseId;\\n\\tvertex2 = baseId + int2( 0, 1 );\\n\\tvertex3
    = baseId + int2( 1, 0 );\\n}\\nelse\\n{\\n\\tWeights.x = -temp.z;\\n\\tWeights.y
    = 1.0 - temp.y;\\n\\tWeights.z = 1.0 - temp.x;\\n\\tvertex1 = baseId + int2(
