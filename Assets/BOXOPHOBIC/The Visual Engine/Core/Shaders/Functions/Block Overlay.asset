    float3 uv = PositionWS * Amount;\\n    float3 cell = floor(uv);\\n\\n    // Inline
    Hash31\\n    float3 p = frac(cell * 0.1031);\\n    p += dot(p, p.yzx + 33.33);\\n   
    float h = frac((p.x + p.y) * p.z);\\n\\n    // Random position inside the voxel\\n   
    float3 rnd = frac(h * float3(13.371, 91.173, 47.853));\\n\\n    float3 delta
    = frac(uv) - rnd;\\n    float d2 = dot(delta, delta);\\n\\n    // Derivative-based
    AA\\n    //float3 fw = fwidth(uv);\\n    //float radius2 = max(0.0064, dot(fw,
    fw) * 0.5625);\\n\\n    // Camera-driven twinkle\\n    float density = smoothstep(0.97,
    1.0, frac(h + CameraRnd));\\n\\n    // Diamond distance (L1 norm)\\n    float
    d = abs(delta.x) + abs(delta.y) + abs(delta.z);\\n\\n     float radiusRnd = frac(h
    * 91.173); \\n     radiusRnd = radiusRnd * radiusRnd * radiusRnd; \\n     float
    radius = Radius * lerp(0.3, 1.0, radiusRnd);\\n\\n    float sparkle = density
    * (1.0 - smoothstep(0.0, radius, d));\\n\\n    // Sparkle\\n    //float sparkle
