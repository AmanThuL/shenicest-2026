			half4 SampleBiplanar( TEXTURE2D(Texture), SamplerState Sampler, float2 ZY, float2 XY, half Bias, half4 BiplanarDefault, half3 BiplanarNormal, half3 Triplanar, half3 NormalWS, out half3 Normal )
			{
				half4 tex_X = SAMPLE_TEXTURE2D_BIAS(Texture, Sampler, ZY, Bias);
				half4 tex_Z = SAMPLE_TEXTURE2D_BIAS(Texture, Sampler, XY, Bias);
				half3 normal_X = half3(tex_X.wy * 2.0 - 1.0, 1.0);
				normal_X = half3(normal_X.xy + NormalWS.zy, NormalWS.x).zyx;
				half3 normal_Z = half3(tex_Z.wy * 2.0 - 1.0, 1.0);
				normal_Z = half3(normal_Z.xy + NormalWS.xy, NormalWS.z).xyz;
				Normal =  normal_X * Triplanar.x + BiplanarNormal * Triplanar.y + normal_Z * Triplanar.z;
				return tex_X * Triplanar.x + BiplanarDefault * Triplanar.y + tex_Z * Triplanar.z;
			}
			
			float CapsuleMask953_g254307( float3 p, float3 a, float3 b, float r )
			{
				float3 pa = p - a, ba = b - a;
				float h = saturate( dot(pa,ba)/dot(ba,ba) );
				return length( pa - ba*h ) - r;
