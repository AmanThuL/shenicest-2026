			}
			
			float CapsuleMask953_g254307( float3 p, float3 a, float3 b, float r )
			{
				float3 pa = p - a, ba = b - a;
				float h = saturate( dot(pa,ba)/dot(ba,ba) );
				return length( pa - ba*h ) - r;
