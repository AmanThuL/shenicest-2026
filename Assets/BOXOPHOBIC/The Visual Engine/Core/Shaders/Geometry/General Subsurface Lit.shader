			float ComputeGlitter3D1273_g253347( float3 PositionWS, float CameraRnd, float Amount, float Radius )
			{
				    float3 uv = PositionWS * Amount;
				    float3 cell = floor(uv);
				    // Inline Hash31
				    float3 p = frac(cell * 0.1031);
				    p += dot(p, p.yzx + 33.33);
				    float h = frac((p.x + p.y) * p.z);
				    // Random position inside the voxel
				    float3 rnd = frac(h * float3(13.371, 91.173, 47.853));
				    float3 delta = frac(uv) - rnd;
				    float d2 = dot(delta, delta);
				    // Derivative-based AA
				    //float3 fw = fwidth(uv);
				    //float radius2 = max(0.0064, dot(fw, fw) * 0.5625);
				    // Camera-driven twinkle
				    float density = smoothstep(0.97, 1.0, frac(h + CameraRnd));
				    // Diamond distance (L1 norm)
				    float d = abs(delta.x) + abs(delta.y) + abs(delta.z);
				     float radiusRnd = frac(h * 91.173); 
				     radiusRnd = radiusRnd * radiusRnd * radiusRnd; 
				     float radius = Radius * lerp(0.3, 1.0, radiusRnd);
				    float sparkle = density * (1.0 - smoothstep(0.0, radius, d));
				    // Sparkle
				    //float sparkle =  density * (1.0 - smoothstep(0.0, radius2, d2));
				    return sparkle;
			}
			
			inline void ASEGetMainLight( out DirectionalLightData light )
			{
				UNITY_BRANCH if ( _DirectionalShadowIndex >= 0 )
				{
					light = _DirectionalLightDatas[ _DirectionalShadowIndex ];
				}
				else
				{
					if ( _DirectionalLightCount == 1 )
					{
						light = _DirectionalLightDatas[ 0 ];
					}
					else if ( _DirectionalLightCount > 1 )
					{
						float highestIntensity = 0;
						uint highestIndex = 0;
						for ( uint i = 0; i < _DirectionalLightCount; i++ )
						{
							float3 color = _DirectionalLightDatas[ i ].color;
							float intensity = max( max( color.r, color.g ), color.b );
							if ( intensity > highestIntensity )
							{
								highestIndex = i;
								highestIntensity = intensity;
							}
						}
						light = _DirectionalLightDatas[ highestIndex ];
					}
					else
					{
						light = ( DirectionalLightData )0;
					}
				}
			}
			
