			half4 SampleCoord( TEXTURE2D(Texture), SamplerState Sampler, half2 UV, half Bias, out half2 Normal )
			{
				half4 tex = SAMPLE_TEXTURE2D_BIAS( Texture, Sampler, UV, Bias);
